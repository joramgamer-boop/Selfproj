---
import { getProfile } from '../get-profile';
import BioSection from '../components/BioSection.astro';
import NowSection from '../components/NowSection.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import SkillsSection from '../components/SkillsSection.astro';
import LinksSection from '../components/LinksSection.astro';

const { profile, BioProse } = await getProfile();

// Which markup draws each Section. The view model says which Sections render
// and in what order; the page only looks up the component for each one.
const sectionComponents = {
  bio: BioSection,
  now: NowSection,
  projects: ProjectsSection,
  skills: SkillsSection,
  links: LinksSection,
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{profile.displayName}</title>
    <meta name="description" content={profile.bio.tagline} />
  </head>
  <body>
    <nav aria-label="Sections">
      <ul>
        {
          profile.sections.map((section) => (
            <li>
              <a href={`#${section.id}`}>{section.title}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <main>
      {
        profile.sections.map((section) => {
          const Section = sectionComponents[section.id];
          return <Section section={section} profile={profile} BioProse={BioProse} />;
        })
      }
    </main>
  </body>
</html>
